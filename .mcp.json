{
  "mcpServers": {
    "corp-notes": {
      "command": "sh",
      "args": [
        "scripts/dogfood-wrap.sh",
        "--name",
        "corp-notes",
        "--policy",
        ".claude/dogfood5-gateway.yaml",
        "--",
        "npx",
        "tsx",
        "demo/server.ts"
      ]
    },
    "repo-filesystem": {
      "command": "sh",
      "args": [
        "scripts/dogfood-wrap.sh",
        "--name",
        "repo-filesystem",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    }
  }
}
