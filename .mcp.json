{
  "mcpServers": {
    "corp-notes": {
      "command": "sh",
      "args": [
        "scripts/dogfood-wrap.sh",
        "--name",
        "corp-notes",
        "--policy",
        ".claude/dogfood6-gateway.yaml",
        "--",
        "npx",
        "tsx",
        "demo/server.ts"
      ],
      "env": {
        "MCP_RECORDER_SINK": "http://127.0.0.1:8787",
        "MCP_RECORDER_SINK_TOKEN": "dogfood6-ingest",
        "NO_PROXY": "127.0.0.1"
      }
    },
    "repo-filesystem": {
      "command": "sh",
      "args": [
        "scripts/dogfood-wrap.sh",
        "--name",
        "repo-filesystem",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "env": {
        "MCP_RECORDER_SINK": "http://127.0.0.1:8787",
        "MCP_RECORDER_SINK_TOKEN": "dogfood6-ingest",
        "NO_PROXY": "127.0.0.1"
      }
    }
  }
}
