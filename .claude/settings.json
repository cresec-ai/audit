{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --data-dir .mcp-recorder --policy .claude/dogfood4-policy.json"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --data-dir .mcp-recorder --policy .claude/dogfood4-policy.json"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --data-dir .mcp-recorder --policy .claude/dogfood4-policy.json"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --data-dir .mcp-recorder --policy .claude/dogfood4-policy.json"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --data-dir .mcp-recorder --policy .claude/dogfood4-policy.json"
          }
        ]
      }
    ]
  }
}
